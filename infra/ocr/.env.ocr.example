# infra/ocr/.env.ocr.example
#
# Copy to `.env.ocr` (gitignored) and fill in. NEVER commit the filled copy.
#
# The OCR worker needs exactly three things: a database to read books from and
# write pages to, storage to fetch the PDFs from, and — only for legacy rows
# that store a bare R2 key instead of a URL — the R2 credentials to presign it.
#
# It needs NO AI provider key. Recognition is a local Tesseract process, and
# `--check-env` prints every host the run contacts so that stays auditable.
# GEMINI_API_KEY is deliberately absent from this file.

# ── Database (the library being written to) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.org
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage (where the PDFs actually live) ──────────────────────────────────
# These two must describe the SAME deployment as the database above. A process
# holding one environment's storage config and another's database credentials
# is the failure lib/indexing/environment.ts exists to refuse — it once wrote
# "unfetchable" against 203 healthy production books.
ZIMA_API_URL=https://storage.example.org
ZIMA_API_KEY=

# ── Legacy Cloudflare R2 (only for old rows storing a bare object key) ──────
# Leave blank unless a candidate book's file_url is not an http(s) URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
