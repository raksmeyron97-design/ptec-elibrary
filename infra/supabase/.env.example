# infra/supabase/.env — self-hosted Supabase for the PTEC e-Library.
#
# Copy to .env in this directory (chmod 600). Never commit .env.
# `scripts/generate-secrets.sh` fills every *generated* value below and refuses
# to overwrite an existing .env; `scripts/preflight.sh` refuses to start the
# stack while any placeholder is still present.
#
# Two ways to obtain JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY:
#   A. REUSE the Cloud project's legacy JWT secret + keys (Dashboard → Project
#      Settings → API → "JWT Settings"). Recommended for the cutover: the
#      app's keys stay the same, restored refresh tokens stay valid, and the
#      analytics HMACs keyed on the service-role key stay continuous. Rotate
#      later with scripts/generate-secrets.sh --rotate-jwt.
#   B. GENERATE new ones (scripts/generate-secrets.sh) — every user re-signs-in
#      and the GitHub repo variable NEXT_PUBLIC_SUPABASE_ANON_KEY changes.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_generate_with_scripts_generate_secrets
# Where the database files live. A path on /DATA so ZimaOS disk tooling and
# the weekly volume backup (README §Backups) cover it.
SUPABASE_DATA_DIR=/DATA/AppData/ptec-supabase/db
# Tuning for ~2 GB (postgres/README.md). Change only after measuring.
PG_MEMORY_LIMIT=2g
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
PG_LOG_MIN_DURATION_MS=500

# ── JWT / API keys (see A/B above) ────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_at_least_32_characters
ANON_KEY=CHANGE_ME_hs256_jwt_role_anon
SERVICE_ROLE_KEY=CHANGE_ME_hs256_jwt_role_service_role
JWT_EXPIRY=3600

# ── Public URLs ───────────────────────────────────────────────────────────────
# Origin the browser and GitHub Actions use for Supabase (through the tunnel).
SUPABASE_PUBLIC_URL=https://supabase.storage-ptec.online
# The application's canonical origin: redirects and emailed links land here.
SITE_URL=https://library.ptec.edu.kh
# Comma-separated extra redirect targets (dev machines, LAN, the tunnel's
# fallback hostname). Wildcards allowed: http://localhost:3000/**
ADDITIONAL_REDIRECT_URLS=https://library.ptec.edu.kh/**,http://localhost:3000/**

# ── Auth behaviour (mirror the Cloud dashboard during preparation) ────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
PASSWORD_HIBP_ENABLED=true
MAILER_OTP_EXP=3600
RATE_LIMIT_EMAIL_SENT=30
RATE_LIMIT_TOKEN_REFRESH=150
RATE_LIMIT_VERIFY=30
RATE_LIMIT_SIGNUPS=30
# Turnstile: the app always sends a captcha token with password sign-in.
# Same value as TURNSTILE_SECRET_KEY in the app's .env. Set AUTH_CAPTCHA_ENABLED=false
# only for a stack the app reaches with Cloudflare's always-pass test keys.
AUTH_CAPTCHA_ENABLED=true
TURNSTILE_SECRET_KEY=CHANGE_ME_turnstile_secret

# ── SMTP (Gmail App Password — same as the app's SMTP_USER/SMTP_PASS) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME_gmail_app_password
SMTP_ADMIN_EMAIL=CHANGE_ME@gmail.com
SMTP_SENDER_NAME=PTEC Library
SMTP_MAX_FREQUENCY=1s

# ── Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 client) ──────
# Authorised redirect URI to ADD there: ${SUPABASE_PUBLIC_URL}/auth/v1/callback
# Keep the Cloud one (https://<ref>.supabase.co/auth/v1/callback) until rollback
# is no longer needed.
GOOGLE_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=CHANGE_ME_google_oauth_secret

# ── Internal service secrets (generated) ──────────────────────────────────────
SECRET_KEY_BASE=CHANGE_ME_64_chars
REALTIME_DB_ENC_KEY=CHANGE_ME_16_chars
PG_META_CRYPTO_KEY=CHANGE_ME_32_chars

# ── Bind addresses (LAN exposure is opt-in) ───────────────────────────────────
KONG_BIND=127.0.0.1
KONG_HTTP_PORT=8000
STUDIO_BIND=127.0.0.1
STUDIO_PORT=3001
STUDIO_DEFAULT_ORGANIZATION=PTEC
STUDIO_DEFAULT_PROJECT=PTEC e-Library

# ── Cloudflare Tunnel (a SECOND tunnel/hostname, separate from the app's) ─────
# Public hostname supabase.storage-ptec.online → service http://kong:8000.
# Leave empty for staging/LAN validation; `--profile tunnel` needs it.
SUPABASE_TUNNEL_TOKEN=

# ── Backups & alerts (scripts/backup-db.sh, scripts/monitor.sh) ───────────────
BACKUP_DIR=/DATA/backups/supabase
BACKUP_RETENTION_DAYS=30
# Optional: encrypt each dump with AES-256 (openssl enc -pbkdf2). Store the
# passphrase in the password manager — a lost passphrase is a lost backup.
BACKUP_PASSPHRASE=
# Telegram (same bot/chat as the app's .env; leave empty to disable alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Resource alert thresholds (percent).
ALERT_RAM_WARN=75
ALERT_RAM_CRIT=85
ALERT_DISK_WARN=75
ALERT_DISK_CRIT=85

# ── Optional path overrides ───────────────────────────────────────────────────
# MAIL_TEMPLATES_DIR=../../supabase/templates
# Image pins (defaults in docker-compose.yml): POSTGRES_IMAGE_TAG, GOTRUE_IMAGE_TAG,
# POSTGREST_IMAGE_TAG, REALTIME_IMAGE_TAG, PG_META_IMAGE_TAG, STUDIO_IMAGE_TAG,
# KONG_IMAGE_TAG, CLOUDFLARED_IMAGE_TAG, BUSYBOX_IMAGE_TAG.
