    "catalogs-hub": {
      "robots": "index",
      "hreflang": true
    },
    "catalog-record": {
      "robots": "noindex",
      "record": true,
      "jsonld": [
        "Book",
        "BreadcrumbList"
      ],
      "ogType": "book"
    },
    "about": {
      "robots": "index",
      "hreflang": true
    },
    "about-page": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
        "BreadcrumbList"
      ]
