{
  "$comment": "Local twin of seo-urls.json for a production build against the seeded local Supabase stack (.env.local → 127.0.0.1:54331). Same templates; slugs from the seed. Phase exits run: npx tsx scripts/seo-check.ts --base http://localhost:3200 --urls scripts/seo-urls.local.json --phase N",
  "sitewideJsonld": [
    "EducationalOrganization",
    "Library",
    "WebSite"
  ],
  "sitewideJsonldTarget": [
    "CollegeOrUniversity",
    "Library",
    "WebSite"
  ],
  "templates": {
    "home": {
      "robots": "index",
      "hreflang": true
    },
    "books-list": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
        "CollectionPage",
        "ItemList"
      ],
      "cardLinks": "^/(km/)?books/[^/]+$",
      "total": true
    },
    "books-list-page": {
      "robots": "index",
      "hreflang": true,
      "cardLinks": "^/(km/)?books/[^/]+$"
    },
    "books-list-page1": {
      "robots": "index"
    },
    "books-list-filtered": {
      "robots": "noindex"
    },
    "books-list-out-of-range": {
      "robots": "noindex"
    },
    "book": {
      "robots": "index",
      "hreflang": true,
      "record": true,
      "scholarly": true,
      "jsonld": [
        "Book",
        "BreadcrumbList"
      ],
      "ogType": "book",
      "ogTypePhase": 1
    },
    "book-read": {
      "robots": "noindex"
    },
    "subjects-hub": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
        "BreadcrumbList",
        "CollectionPage",
        "ItemList"
      ]
    },
    "subject": {
      "robots": "index",
      "hreflang": true,
      "record": true,
      "jsonld": [
        "BreadcrumbList",
        "CollectionPage"
      ],
      "cardLinks": "^/(km/)?books/[^/]+$"
    },
    "authors-hub": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
        "BreadcrumbList",
        "CollectionPage",
        "ItemList"
      ],
      "cardLinks": "^/(km/)?authors/[^/]+$"
    },
    "author": {
      "robots": "index",
      "hreflang": true,
      "record": true,
      "jsonld": [
        "ProfilePage",
        "BreadcrumbList"
      ],
      "ogType": "profile"
    },
    "author-thin": {
      "robots": "noindex",
      "robotsPhase": 2,
      "record": true
    },
    "theses-hub": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
        "CollectionPage",
        "ItemList"
