      "jsonld": [
        "ScholarlyArticle",
        "BreadcrumbList"
      ],
      "jsonldTarget": [
        "PublicationIssue",
        "PublicationVolume",
        "Periodical"
      ],
      "ogType": "article"
    },
    "posts-hub": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
