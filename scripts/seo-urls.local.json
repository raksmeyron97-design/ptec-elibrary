      "robots": "index",
      "hreflang": true,
      "record": true,
      "scholarly": true,
      "jsonld": [
        "ScholarlyArticle",
        "BreadcrumbList"
      ],
      "jsonldTarget": [
        "Thesis"
      ]
    },
    "journals-hub": {
      "robots": "index",
      "hreflang": true,
      "jsonld": [
        "CollectionPage",
        "ItemList"
