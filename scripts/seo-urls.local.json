    },
    "search": {
      "robots": "noindex"
    },
    "offline-shell": {
      "robots": "noindex",
      "robotsPhase": 1
    },
    "missing": {
      "status": 404
    },
    "redirect-308": {
      "status": 308
    },
    "redirect-301": {
      "status": 301
    },
    "subject-thin": {
      "robots": "noindex",
      "record": true,
      "jsonld": [
        "BreadcrumbList",
        "CollectionPage"
      ]
    },
    "catalog-record-described": {
      "robots": "index",
      "hreflang": true,
      "record": true,
      "jsonld": [
        "Book",
        "BreadcrumbList"
      ],
      "ogType": "book"
    }
