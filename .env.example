
# ── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Cloudflare R2 Storage (Private PDF Bucket) ────────────────────────────────
# Create an R2 API Token in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# លេខ Account ID នេះគឺទាញចេញពី Endpoint URL របស់អ្នក
# Find in: Cloudflare Dashboard → R2 → Overview (right sidebar)
R2_ACCOUNT_ID="your_cloudflare_account_id"

# URL សម្រាប់ឲ្យសិស្សទាញយកឯកសារ (ត្រូវមានពាក្យ NEXT_PUBLIC_ ដើម្បីឲ្យ Client Side អាចប្រើបាន)
# Enable public access on your R2 bucket to get this URL
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-your-hash.r2.dev"

# កុំភ្លេចបំពេញឈ្មោះ Bucket ដែលអ្នកបានបង្កើត (ឧទាហរណ៍៖ elibrary-books)
R2_BUCKET_NAME="your-private-pdf-bucket-name"

# ── Cloudflare R2 (Public Covers Bucket) ─────────────────────────────────────
# Create a separate R2 bucket with public access enabled for book cover images
R2_PUBLIC_BUCKET_NAME="your-public-covers-bucket-name"
NEXT_PUBLIC_R2_COVERS_URL="https://pub-your-covers-hash.r2.dev"

# ── Site URLs ─────────────────────────────────────────────────────────────────
# Origin only (no path). Invalid/loopback values fall back to the production
# origin in indexable environments — see lib/seo/site.ts.
#
# This is load-bearing beyond SEO on the self-hosted deployment: it is the
# origin every auth callback and every emailed verification/reset link is built
# on (lib/site-origin.ts), and setting it to the canonical production domain is
# what marks this container as indexable (lib/seo/indexing.ts). Production
# value: https://library.ptec.edu.kh — NOT the tunnel's fallback hostname.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_ROOT_DOMAIN="your-domain.com"

# ── SEO indexing override (optional — lib/seo/indexing.ts) ────────────────────
# Indexing is opt-in. Indexable by default on Vercel production, and on the
# self-hosted container when NEXT_PUBLIC_SITE_URL is the canonical production
# origin — so production does NOT need this variable.
# "on"  = force indexable (a staging hostname, CI e2e)
# "off" = emergency noindex kill switch, even on production
# Leave unset everywhere else. Previews/staging must stay noindex.
# SEO_INDEXING=

# ── Zima Storage (primary file storage) ──────────────────────────────────────
# Self-hosted storage API. All new uploads (books, covers, theses, posts) go
# here; R2 above is only a legacy fallback for old records.
ZIMA_API_URL="https://api.your-storage-domain.com"
ZIMA_API_KEY="your_zima_api_key"

# ── Cloudflare Turnstile CAPTCHA ──────────────────────────────────────────────
# Site key is safe to expose publicly. Get it from: Cloudflare Dashboard → Turnstile
# The secret key is used server-side by /api/contact (and by Supabase Auth via
# the Supabase Dashboard). NEVER commit the real secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA_your_turnstile_site_key"
TURNSTILE_SECRET_KEY="0x4AAAAAAA_your_turnstile_secret_key"

# ── Gmail API (contact form + admin inbox) ────────────────────────────────────
# /api/contact saves messages to the contact_messages table and sends
# notification/confirmation/reply emails through the Gmail API (OAuth2,
# gmail.send scope only — see lib/gmail.ts). Server-side only, never exposed
# to the browser.
#
# One-time setup: run `node scripts/get-gmail-refresh-token.mjs` (see the
# comment header in that file for the full Google Cloud Console steps) to
# obtain GOOGLE_REFRESH_TOKEN for ADMIN_GMAIL_ADDRESS.
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REFRESH_TOKEN="your_gmail_oauth_refresh_token"
ADMIN_GMAIL_ADDRESS="library@your-domain.com"
CONTACT_FROM_NAME="PTEC Digital Library"

# ── Admin maintenance endpoints ───────────────────────────────────────────────
# Bearer token protecting /api/admin/backfill-embeddings.
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY="your_long_random_admin_secret"

# ── ZimaOS self-hosting (see docs/ZIMAOS-DEPLOYMENT.md) ───────────────────────
# Cloudflare Tunnel token for the `cloudflared` compose service. Treat as a
# secret. For library.ptec.edu.kh this token comes from the administrator of
# the ptec.edu.kh zone — send them docs/DNS-HANDOFF.md.
# Leave it unset to run LAN-only: deploy.sh enables the tunnel compose profile
# only when this is present, which is what makes validation stages 1-2 work.
# TUNNEL_TOKEN="your_cloudflare_tunnel_token"

# Which image the box runs. Unset = "main", i.e. whatever CI last published.
# Set to a sha-<40-char> or v1.2.3 tag to pin a version or roll back, then run
# `sudo ./deploy/deploy.sh --force`. Not a secret.
# IMAGE_TAG="main"

# ── DDoS / abuse protection (see docs/DDOS-PROTECTION.md) ─────────────────────
# Emergency switches — all default OFF. Set to "true" and redeploy to activate.
# DDOS_MODE=true implies all three switches below it.
# DDOS_MODE="true"
# STRICT_RATE_LIMIT="true"          # divide public rate limits by 3
# DISABLE_EXPENSIVE_SEARCH="true"   # skip AI summary + autocomplete (search still works)
# PDF_DOWNLOAD_LIMIT_STRICT="true"  # clamp PDF read/download limits hard
#
# Optional per-route limit overrides (requests per window; sensible defaults
# apply when unset — see lib/rate-limit-policy.ts):
# RL_SEARCH_PER_MIN=10
# RL_SEARCH_NATIVE_PER_MIN=30
# RL_SUGGESTIONS_PER_MIN=60
# RL_FILE_READ_PER_MIN=30
# Ranged continuations of an already-open PDF. Separate from RL_FILE_READ
# because pdf.js reads a book in chunks: one reader opening one large book
# issues many ranged requests, and metering each as a fresh "file read" made
# them exceed their own limit mid-open. Set it equal to RL_FILE_READ_PER_MIN
# to restore the previous (single-bucket) behaviour.
# RL_FILE_RANGE_PER_MIN=240
# RL_DOWNLOAD_PER_MIN=5
# RL_REVIEWS_PER_10MIN=5
# RL_NOTES_PER_MIN=40

# ── Gmail SMTP (for Supabase auth emails) ────────────────────────────────────
# Used by supabase/config.toml [auth.email.smtp] (local dev) and mirrored in
# the Supabase Dashboard → Project Settings → Auth → SMTP Settings (production).
#
# SMTP_USER  — your full Gmail address, e.g. library@gmail.com
# SMTP_PASS  — a 16-char Gmail App Password (NOT your real Gmail password).
#              To generate one:
#                1. Enable 2-Step Verification on the Google account.
#                2. Go to https://myaccount.google.com/apppasswords
#                3. Create an app → copy the 16-char password (no spaces).
#              Gmail free tier allows ~500 emails/day.
#              To switch providers later (Resend, SendGrid, SES), change only
#              host/port/user/pass in config.toml — no other code changes needed.
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# ── AI Assistant (server-side only — NEVER prefix with NEXT_PUBLIC_) ─────────
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key"

# ── Malware scanning (optional — uploads work without it) ───────────────────
# Hash-reputation lookup against VirusTotal for every admin file upload
# (see lib/virus-scan.ts). Free tier account: https://www.virustotal.com/gui/join-us
# Fails open if unset — uploads are not blocked, just unscanned.
VIRUSTOTAL_API_KEY="your_virustotal_api_key"

# ── Chunked upload staging ────────────────────────────────────────────────────
# Where the parts of a large PDF are kept between the requests that carry them.
#
# MUST be a durable, writable directory that survives a container restart. In
# production it is a Docker volume (docker-compose.yml mounts `upload-staging`
# here). Unset, it falls back to os.tmpdir() — which in the production image is
# a tmpfs, i.e. RAM that is erased on every deploy, and the reason a restart
# mid-upload used to surface as "Missing chunk 0 during final assembly".
#
# Size it for a few concurrent 100 MB uploads. Anything no live session owns is
# reclaimed by /api/cron/upload-reconcile.
UPLOAD_STAGING_DIR="/app/.upload-staging"
# Optional. Identifies the process holding staged chunks, so a request that
# reaches an instance which cannot see them says so instead of reporting the
# parts as missing. Defaults to hostname:pid.
#UPLOAD_INSTANCE_ID=""

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Shared secret protecting /api/cron/* routes (e.g. /api/cron/cleanup, which
# purges stale rate_limit rows daily). Generate with: openssl rand -hex 32
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>";
# external cron services must send the same header.
CRON_SECRET="your_long_random_cron_secret"

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
# Used for push notifications (new-publication alerts, admin broadcasts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
# Preferred contact subject for VAPID. VAPID_MAILTO remains supported for older deployments.
VAPID_SUBJECT="mailto:library@your-domain.com"
VAPID_MAILTO="mailto:library@your-domain.com"

# ── Admin engagement chart rollout (optional — lib/admin/analytics-flags.ts) ──
# "on"  = force the V2 analytics chart (including in production)
# "off" = force the legacy chart (including in development)
# Unset: production gets legacy, development gets V2.
# The value must be exactly "on" or "off" — anything else fails closed to
# legacy, so do not paste the Vercel dashboard's "on (Environment: Production)".
# ADMIN_ENGAGEMENT_CHART_V2=

# ── Backups & ops alerts (box-side; see docs/BACKUP-DR.md) ───────────────────
# Encrypts DB backups + optional --encrypt file copies (AES-256-GCM).
# BACKUP_PASSPHRASE="a-long-random-passphrase-kept-in-the-password-manager"
# Nightly Zima Storage file mirror (deploy/ptec-storage-backup.timer):
# source = the Zima Storage data directory on the box, target = the
# second-disk / off-site mount. Both unset = timer stays disabled.
# STORAGE_BACKUP_SOURCE="/DATA/AppData/zima-storage/data"
# STORAGE_BACKUP_TARGET="/mnt/backup/ptec-storage"

# ── Telegram (contact-form delivery + Sev 1/2 ops alerts) ────────────────────
# One bot, two duties: /api/contact messages and the alert channel
# (scripts/ops/alert-telegram.mjs, uptime.yml/cron.yml failure steps — set the
# same two values as GitHub Actions repo secrets). Test with:
#   node scripts/ops/alert-telegram.mjs --test
TELEGRAM_BOT_TOKEN="123456:your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# ── Malware-scan posture (lib/virus-scan.ts) ─────────────────────────────────
# Default (unset/anything else): a scan that cannot complete (no
# VIRUSTOTAL_API_KEY, timeout, API error) FAILS OPEN — the upload proceeds
# and a virus_scan_skipped / virus_scan_error security event is logged.
# "true": such uploads are rejected with 503 (a VT "hash unknown" answer
# still passes — only scans that could not run at all are rejected).
# FAIL_CLOSED_VIRUS_SCAN=true

# ── Security monitoring (docs/SECURITY-MONITORING.md §Configuration) ─────────
# Every value has a safe default; set one only to retune. The defaults come
# from docs/ALERT-CATALOG.md wherever the catalog states a threshold.

# Detection pass (cron: .github/workflows/cron.yml, every 5 min)
# SECURITY_DETECT_LOOKBACK_MINUTES=60     # window each pass examines
# SECURITY_DETECT_MAX_EVENTS=20000        # hard row cap per pass

# Authentication (observable because sign-in is proxied server-side)
# AUTH_ATTACK_WINDOW_SECONDS=900          # counting window for auth failures
# AUTH_ATTACK_THRESHOLD=10                # failures on ONE account -> brute force
# CREDENTIAL_STUFFING_ACCOUNTS=5          # accounts from one client -> stuffing
# MFA_FAILURE_THRESHOLD=5                 # rejected TOTP codes in the window
# AUTH_SUSPICIOUS_SUCCESS_AFTER=8         # failures before a success reads as breach
# ADMIN_AUTH_ANOMALY_THRESHOLD=10         # catalog admin-auth-anomaly: >10/h
# ADMIN_AUTH_ANOMALY_WINDOW_SECONDS=3600

# Abuse
# RATE_LIMIT_ALERT_THRESHOLD=100          # catalog rate-limit-storm: >100/h
# RATE_LIMIT_ALERT_WINDOW_SECONDS=3600
# CAPTCHA_STORM_THRESHOLD=50              # catalog captcha-storm: >50/h
# DOWNLOAD_ABUSE_THRESHOLD=60
# ENUMERATION_THRESHOLD=25
# ENUMERATION_WINDOW_SECONDS=600
# INJECTION_THRESHOLD=3                   # >1 on purpose: signatures false-positive
# UPLOAD_ABUSE_THRESHOLD=10
# UPLOAD_ABUSE_WINDOW_SECONDS=3600
# WAF_SPIKE_THRESHOLD=10                  # unused until a Cloudflare source exists

# Baselines
# BASELINE_DEVIATION_FACTOR=5             # multiple of baseline worth reporting
# BASELINE_MIN_SAMPLES=24                 # below this, fixed thresholds are used
# BASELINE_WINDOW_DAYS=14

# Incidents and alerting
# INCIDENT_RECOVERY_QUIET_SECONDS=1800    # quiet period before recovery
# INCIDENT_DEDUPE_WINDOW_SECONDS=900
# ALERT_COOLDOWN_SECONDS=3600             # minimum gap between alerts per incident
# SECURITY_ALERT_MIN_SEVERITY=2           # only Sev 1-2 reach Telegram
# SECURITY_ALERTING_ENABLED=true          # master off switch for maintenance
# SECURITY_ALERT_MAX_ATTEMPTS=3
# ALERT_PIPELINE_FAILURE_THRESHOLD=3      # failures before the pipeline self-reports
# SECURITY_SPIKE_THRESHOLD=20             # in-process burst detector (pre-existing)

# Retention (purged daily by /api/cron/cleanup)
# SECURITY_EVENT_RETENTION_DAYS=180
# ALERT_DELIVERY_RETENTION_DAYS=180
# SECURITY_BASELINE_RETENTION_DAYS=90

# Sign-in rate limits (added with the server-side login proxy)
# RL_LOGIN_PER_5MIN=10
# RL_LOGIN_PER_ACCOUNT_PER_15MIN=15
# RL_MFA_VERIFY_PER_5MIN=10
