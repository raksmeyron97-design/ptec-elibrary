{
  "projectId": "644eff15-f7e9-4adb-86f0-19acb1265cfa",
  "shape": "package",
  "pkg": "ptec-e-library",
  "globalName": "PTECLibrary",
  "buildCmd": "node .ds-sync/compile-css.mjs && echo 'CSS compiled'",
  "tsconfig": "./tsconfig.json",
  "cssEntry": ".design-sync/compiled-globals.css",
  "runtimeFontPrefixes": [
    "Inter",
    "Angkor",
    "Crimson Pro",
    "Suwannaphum"
  ],
  "extraEntries": [
    "./.design-sync/preview-provider.tsx"
  ],
  "guidelinesGlob": [
    "docs/ACCESSIBILITY-FOCUS.md"
  ],
  "dtsPropsFor": {
    "Badge": "children: React.ReactNode; variant?: 'neutral' | 'brand' | 'success' | 'warning' | 'danger' | 'info'; className?: string;",
    "Button": "children: React.ReactNode; variant?: 'primary' | 'secondary' | 'ghost' | 'gold'; size?: 'sm' | 'md' | 'lg'; disabled?: boolean; type?: 'button' | 'submit' | 'reset'; onClick?: React.MouseEventHandler<HTMLButtonElement>; className?: string;",
    "Card": "children: React.ReactNode; interactive?: boolean; className?: string;",
    "CardHeader": "children?: React.ReactNode; className?: string;",
    "CardContent": "children?: React.ReactNode; className?: string;",
    "Icon": "name: 'account' | 'arrow-left' | 'bookmark' | 'bookmark-plus' | 'calendar' | 'chevron-right' | 'clock' | 'devices' | 'file-check' | 'globe' | 'library' | 'mail' | 'map-pin' | 'pdf' | 'phone' | 'school' | 'search' | 'search-off' | 'send' | 'star' | 'bell' | 'download' | 'external-link' | 'x' | 'share' | 'plus-square' | 'check' | 'spinner' | 'trash' | 'sun' | 'moon' | 'camera' | 'alert-triangle' | 'edit' | 'eye' | 'settings'; className?: string;",
    "SectionTitle": "children: React.ReactNode; as?: 'h1' | 'h2' | 'h3' | 'h4'; className?: string;",
    "ThemeToggle": "/* no props — renders a fixed layout */",
    "RatingStars": "rating: number; compact?: boolean;",
    "Avatar": "url: string | null; name: string | null; email: string; size?: number; className?: string;",
    "BookCover": "title: string; label?: string | null; author?: string | null; variant?: 'card' | 'thumb' | 'detail' | 'hero'; className?: string;",
    "SkeletonBlock": "className?: string; style?: React.CSSProperties;",
    "SkeletonText": "className?: string;",
    "SkeletonCircle": "size?: number;",
    "BookDetailSkeleton": "/* no props — renders a fixed layout */",
    "AuthSkeleton": "/* no props — renders a fixed layout */",
    "AdminFormSkeleton": "sections?: number;",
    "AdminTableSkeleton": "rows?: number; columns?: number[];",
    "GenericPageSkeleton": "/* no props — renders a fixed layout */"
  },
  "provider": {
    "component": "PreviewIntlProvider"
  },
  "componentSrcMap": {
    "Badge": "components/ui/core/Badge.tsx",
    "Button": "components/ui/core/Button.tsx",
    "Card": "components/ui/core/Card.tsx",
    "CardHeader": "components/ui/core/Card.tsx",
    "CardContent": "components/ui/core/Card.tsx",
    "Icon": "components/ui/core/Icon.tsx",
    "SectionTitle": "components/ui/core/SectionTitle.tsx",
    "ThemeToggle": "components/ui/core/ThemeToggle.tsx",
    "RatingStars": "components/ui/reviews/RatingStars.tsx",
    "Avatar": "components/ui/Avatar.tsx",
    "BookCover": "components/ui/books/BookCover.tsx",
    "SkeletonBlock": "components/ui/skeletons/SkeletonBlock.tsx",
    "SkeletonText": "components/ui/skeletons/SkeletonBlock.tsx",
    "SkeletonCircle": "components/ui/skeletons/SkeletonBlock.tsx",
    "BookDetailSkeleton": "components/ui/skeletons/BookDetailSkeleton.tsx",
    "AuthSkeleton": "components/ui/skeletons/AuthSkeleton.tsx",
    "AdminFormSkeleton": "components/ui/skeletons/AdminFormSkeleton.tsx",
    "AdminTableSkeleton": "components/ui/skeletons/AdminTableSkeleton.tsx",
    "GenericPageSkeleton": "components/ui/skeletons/GenericPageSkeleton.tsx"
  },
  "overrides": {
    "BookCover": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}