{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "comment": "All audited URLs. SEO + canonical live in the auth-excluding entry below: noindex utility pages (e.g. /auth/login) legitimately fail is-crawlable and must not be held to a public-SEO score.",
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.75 }],
            "categories:pwa": "off",

            "errors-in-console": ["warn", { "minScore": 1 }],
            "viewport": "error",
            "document-title": "error",
            "html-has-lang": "error",

            "resource-summary:script:size": ["warn", { "maxNumericValue": 450000 }],
            "resource-summary:total:size": ["warn", { "maxNumericValue": 2500000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 600 }]
          }
        },
        {
          "comment": "Indexable content pages only — everything except /auth/* (login/signup are noindex by design, so a public-SEO threshold and canonical assertion are false signals there).",
          "matchingUrlPattern": "^(?!.*/auth/).*$",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.95 }],
            "canonical": "error"
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
