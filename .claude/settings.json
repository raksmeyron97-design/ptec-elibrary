{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(npm run lint*)",
      "Bash(npm audit*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest run*)",
      "Bash(node scripts/audit-gate.mjs)",
      "Bash(lsof -ti:3000)",
      "Bash(curl -s* http://localhost:3000/*)",
      "WebFetch(domain:library.ptec.edu.kh)",
      "Read(//tmp/**)"
    ],
    "additionalDirectories": [
      "/private/tmp"
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  }
}
